{
	"name": "Azuregen2json",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"foldername": {
				"type": "string"
			},
			"targetname": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().targetname",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('raw/',dataset().foldername)",
					"type": "Expression"
				},
				"fileSystem": "devcontainer"
			}
		},
		"schema": {}
	}
}