{
	"name": "09_copy_activity_wildcardpath",
	"properties": {
		"activities": [
			{
				"name": "timestamp",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_Current_timestamp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "timestamp",
					"value": {
						"value": "@addDays(variables('getcurrenttimestamp'),-1)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "get_file_name",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "timestamp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "filename",
					"value": {
						"value": "@formatDateTime(variables('timestamp'),'ddMMyyyy')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get_Current_timestamp",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "getcurrenttimestamp",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "get_file_name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "inbound",
							"wildcardFileName": {
								"value": "@concat('*',variables('filename'),'*.txt')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_source_wildcardpath",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sink_wildcardpath",
						"type": "DatasetReference"
					}
				]
			}
		],
		"variables": {
			"filename": {
				"type": "String"
			},
			"timestamp": {
				"type": "String"
			},
			"getcurrenttimestamp": {
				"type": "String"
			}
		},
		"annotations": []
	}
}