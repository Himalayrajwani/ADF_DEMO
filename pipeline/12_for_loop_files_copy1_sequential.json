				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "files_list",
					"value": [
						"revenue_file.txt",
						"sales_department.txt",
						"income_tax_department.txt"
					]
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
